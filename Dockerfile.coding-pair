# Fixed oracle launcher builds only on verified account EC2; no new privilege.
FROM --platform=linux/amd64 public.ecr.aws/docker/library/rust:1.90.0-alpine3.22@sha256:ee9b9f2ebd8741e4ecf1ade08918e492d642c4e625be481bb7b7954b89e9d504 AS oracle-initializer
WORKDIR /build/processing_bootstrap
COPY processing_bootstrap/Cargo.toml processing_bootstrap/Cargo.lock ./
COPY processing_bootstrap/src ./src
COPY src/amlas/evaluation/coding_oracle_child.py /build/src/amlas/evaluation/coding_oracle_child.py
COPY src/amlas/evaluation/coding_oracle.py /build/src/amlas/evaluation/coding_oracle.py
COPY src/amlas/evaluation/coding_oracle_catalog.py /build/src/amlas/evaluation/coding_oracle_catalog.py
RUN cargo build --release --locked --offline --features oracle-child-v1 --bin amlas-oracle-init --target x86_64-unknown-linux-musl && \
    cargo build --release --locked --offline --features sagemaker-native-v1 --bin amlas-processing-init --target x86_64-unknown-linux-musl

# Fixed AMD64 CPU broker for paired HumanEval. Build only on verified account EC2.
# Retain the full locked CPU closure: package initializers register existing
# graders/adapters and import numpy/scikit-learn; a stdlib-only claim is false.
FROM --platform=linux/amd64 public.ecr.aws/docker/library/python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS dependencies
WORKDIR /build
COPY uv.lock /build/uv.lock
COPY scripts/paired_worker_requirements.py /build/paired_worker_requirements.py
RUN python /build/paired_worker_requirements.py /build/uv.lock /build/requirements.txt && \
    python -m venv /opt/venv && \
    /opt/venv/bin/python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r /build/requirements.txt

FROM --platform=linux/amd64 public.ecr.aws/docker/library/python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93
ARG AMLAS_SOURCE_COMMIT
ENV AMLAS_SOURCE_COMMIT=$AMLAS_SOURCE_COMMIT AMLAS_CODING_PAIR_SOURCE_COMMIT=$AMLAS_SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$AMLAS_SOURCE_COMMIT
RUN python -c 'import os,re; assert re.fullmatch("[a-f0-9]{40}",os.environ.get("AMLAS_CODING_PAIR_SOURCE_COMMIT",""))' && \
    useradd --no-create-home --uid 10001 appuser && \
    mkdir -p /opt/ml/processing/input /opt/ml/processing/output && \
    chown 10001:10001 /opt/ml/processing/output && chmod 0700 /opt/ml/processing/output
COPY --from=dependencies /opt/venv /opt/venv
COPY --from=oracle-initializer --chmod=0555 /build/processing_bootstrap/target/x86_64-unknown-linux-musl/release/amlas-oracle-init /usr/local/bin/amlas-oracle-init
COPY --from=oracle-initializer --chmod=0555 /build/processing_bootstrap/target/x86_64-unknown-linux-musl/release/amlas-processing-init /usr/local/bin/amlas-processing-init
COPY --chmod=0555 processing_bootstrap/processing_identity.py /app/processing_identity.py
COPY --chmod=0555 src/amlas/evaluation/coding_oracle_child.py /app/oracle/coding_oracle_child.py
COPY --chmod=0555 src/amlas/evaluation/coding_oracle.py /app/oracle/coding_oracle.py
COPY --chmod=0555 src/amlas/evaluation/coding_oracle_catalog.py /app/oracle/coding_oracle_catalog.py
WORKDIR /app
COPY --chmod=0555 src/ /app/src/
COPY --chmod=0444 VERSION /app/VERSION
COPY --chmod=0555 scripts/coding_pair_worker_native.py /app/coding_pair_worker.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ENV OTEL_SDK_DISABLED=true STRANDS_TELEMETRY_ENABLED=false
# Closure-only import: no main, data source, model loader, session or AWS call.
RUN /opt/venv/bin/python -I -B -c 'import sys; sys.path.insert(0, "/app/src"); import amlas.sagemaker_entrypoints.coding_pair; from amlas.evaluation.coding_pair_runner import paired_runner_sha256; assert len(paired_runner_sha256(oracle_launcher_sha256="0"*64)) == 64'
USER 0:0
ENTRYPOINT ["/usr/local/bin/amlas-processing-init", "coding-pair"]
