# Trusted fixed OS initializer; data/SDK execution starts only after verified drop.
FROM --platform=linux/amd64 public.ecr.aws/docker/library/rust:1.90.0-alpine3.22@sha256:ee9b9f2ebd8741e4ecf1ade08918e492d642c4e625be481bb7b7954b89e9d504 AS initializer
WORKDIR /build
COPY processing_bootstrap/Cargo.toml processing_bootstrap/Cargo.lock ./
COPY processing_bootstrap/src ./src
RUN cargo build --release --locked --offline --features sagemaker-native-v1 --target x86_64-unknown-linux-musl

# Fixed AMD64 data guest; the SDK is present only for credential-presence probes.
FROM --platform=linux/amd64 public.ecr.aws/docker/library/python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93
ARG AMLAS_SOURCE_COMMIT
LABEL org.opencontainers.image.revision=$AMLAS_SOURCE_COMMIT
ENV AMLAS_SOURCE_COMMIT=$AMLAS_SOURCE_COMMIT
RUN python -c 'import os,re; assert re.fullmatch("[a-f0-9]{40}",os.environ.get("AMLAS_SOURCE_COMMIT",""))'
WORKDIR /app
COPY uv.lock ./uv.lock
# Hash-enforced binary closure from the existing canonical dependency lock.
RUN python -c 'import tomllib; p={x["name"]:x for x in tomllib.load(open("uv.lock","rb"))["package"]}; todo=["numpy","pandas","pyarrow","boto3"]; seen=set(); f=open("/app/requirements.inspection.txt","w"); exec("while todo:\n n=todo.pop()\n if n in seen: continue\n seen.add(n)\n q=p[n]\n todo.extend(d[\"name\"] for d in q.get(\"dependencies\",[]))\n hashes=[x[\"hash\"] for x in q.get(\"wheels\",[])]\n if not hashes: raise RuntimeError(\"unhashed binary dependency\")\n f.write(n+\"==\"+q[\"version\"]+\" \"+\" \".join(\"--hash=\"+h for h in hashes)+\"\\n\")")' && \
    pip install --no-cache-dir --only-binary=:all: --require-hashes -r /app/requirements.inspection.txt && \
    useradd --create-home --uid 10001 appuser && \
    mkdir -p /opt/ml/processing/output && chown 10001:10001 /opt/ml/processing && chmod 0755 /opt/ml/processing && chown 10001:10001 /opt/ml/processing/output && chmod 0700 /opt/ml/processing/output
COPY --from=initializer --chmod=0555 /build/target/x86_64-unknown-linux-musl/release/amlas-processing-init /usr/local/bin/amlas-processing-init
COPY processing_bootstrap/processing_identity.py /app/processing_identity.py
COPY src/amlas/data_eng/inspection_schema.py /app/inspection_schema.py
COPY src/amlas/sagemaker_entrypoints/dataset_inspection.py /app/inspect_dataset.py
RUN chmod 0555 /app/inspect_dataset.py /app/inspection_schema.py /app/processing_identity.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
USER root
ENTRYPOINT ["/usr/local/bin/amlas-processing-init", "inspection"]
